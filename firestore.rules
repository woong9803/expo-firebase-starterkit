rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // 공통 헬퍼 함수
    // ─────────────────────────────────────────────

    // 로그인 여부 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 현재 사용자 문서 가져오기
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 현재 사용자의 역할 반환
    function getUserRole() {
      return getUserData().role;
    }

    // 특정 학원의 소속 멤버인지 확인
    function isAcademyMember(academyId) {
      return getUserData().academy_id == academyId;
    }

    // 온보딩 중인 사용자 — 아직 학원에 속하지 않은 상태
    // users 문서가 없거나 academy_id가 빈 값이면 true
    // get('academy_id', '') 로 필드 없음/null 모두 안전하게 처리
    function isOnboarding() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('academy_id', '') == '';
    }

    // admin 또는 teacher 역할인지 확인
    function isStaff() {
      return getUserRole() in ['admin', 'teacher'];
    }

    // admin 역할인지 확인
    function isAdmin() {
      return getUserRole() == 'admin';
    }

    // 탈퇴 처리(소프트 삭제)된 유저인지 확인
    // deleted_at 필드가 null이거나 없어야 정상 유저
    // Cloud Function이 deleted_at을 기록한 직후 클라이언트 signOut 전까지의 접근을 Rules 레벨에서 차단
    function isNotDeleted() {
      return getUserData().get('deleted_at', null) == null;
    }

    // 학원 승인 상태가 active인지 확인
    // 선생님 초대 등 active 상태에서만 허용되는 기능에 사용
    function isAcademyActive(academyId) {
      return get(/databases/$(database)/documents/academies/$(academyId)).data.status == 'active';
    }

    // 학원 승인 상태가 pending 또는 active인지 확인 (rejected 차단용)
    // 승인 대기 중에도 기본 기능(출결·숙제·공지)은 허용
    function isAcademyPendingOrActive(academyId) {
      return get(/databases/$(database)/documents/academies/$(academyId)).data.status
             in ['pending', 'active'];
    }

    // 현재 사용자의 academy_id로 학원 상태 확인
    function isMyAcademyPendingOrActive() {
      return isAcademyPendingOrActive(getUserData().academy_id);
    }

    // 유료 플랜 여부 확인 (starter/standard/pro/trial 모두 유료)
    // domain-terms.md: plan != 'free' 를 유료로 간주
    // 만료 체크 (이중 방어선):
    //  - starter/standard/pro: plan_expires_at (verifyTossPayment에서 설정)
    //  - trial: trial_ends_at (학원 생성 시 +14일)
    function isPaidPlan(academyId) {
      let academy = get(/databases/$(database)/documents/academies/$(academyId)).data;
      return academy.plan != 'free'
        && (academy.plan != 'trial'
            || academy.get('trial_ends_at', null) == null
            || academy.trial_ends_at > request.time)
        && (academy.get('plan_expires_at', null) == null
            || academy.plan_expires_at > request.time);
    }

    // 현재 사용자 학원이 유료 플랜인지 확인
    function isMyAcademyPaid() {
      return isPaidPlan(getUserData().academy_id);
    }

    // 스탠다드/프로 전용 기능 게이트 (영상·자동알림·읽음확인 등)
    // PRD 685 줄 플랜표 기준: trial·starter·free 는 차단
    // 만료 체크: plan_expires_at 미래여야 통과 (verifyTossPayment 가 갱신)
    function isStandardOrProPlan(academyId) {
      let academy = get(/databases/$(database)/documents/academies/$(academyId)).data;
      return (academy.plan == 'standard' || academy.plan == 'pro')
        && (academy.get('plan_expires_at', null) == null
            || academy.plan_expires_at > request.time);
    }

    // 현재 사용자 학원이 스탠다드/프로 플랜인지 확인
    function isMyAcademyStandardOrPro() {
      return isStandardOrProPlan(getUserData().academy_id);
    }

    // 학생 퇴원/복구 처리 시 is_active와 withdrawal_date의 일관성 검증 (옵션 B 무결성)
    // - 퇴원(is_active: false) 시: withdrawal_date는 반드시 값이 있고, 미래 시점 금지
    // - 복구(is_active: false → true) 시: 클라이언트 직접 쓰기 차단
    //   → restoreStudent Cloud Function 만 허용 (서버에서 플랜별 학생 수 한도 재검증 필요)
    //   → CF 는 Admin SDK 로 Rules 를 우회하므로 본 함수는 클라이언트 경로만 제한
    // - is_active 미변경(기타 필드만 수정) 시: withdrawal_date 단독 수정 차단
    //   → 클라이언트가 두 필드를 분리해 동기화 깨뜨리는 경로 봉쇄
    function isWithdrawalConsistent() {
      let next = request.resource.data;
      let touchedActive = next.is_active != resource.data.is_active;
      let touchedWithdrawal = next.get('withdrawal_date', null) != resource.data.get('withdrawal_date', null);
      return (
        // 케이스 1: 퇴원 — is_active false + withdrawal_date 값 존재 + 미래 금지
        (touchedActive && next.is_active == false
            && resource.data.get('is_active', false) == true
            && next.get('withdrawal_date', null) != null
            && next.withdrawal_date <= request.time)
        // 케이스 2: 두 필드 모두 안 건드림 — 일반 정보 수정
        || (!touchedActive && !touchedWithdrawal)
      );
    }

    // ─────────────────────────────────────────────
    // academies/{academyId} — 학원
    // ─────────────────────────────────────────────
    match /academies/{academyId} {
      // 소속 멤버이거나, 온보딩 중인 사용자는 읽기 가능
      // 온보딩 중 선생님이 academy_code로 학원 조회 시 필요
      allow read: if isAuthenticated()
                  && (isAcademyMember(academyId) || isOnboarding());
      // admin만 학원 정보 수정 가능 (active 상태에서만) — 탈퇴 유저 차단
      // P2-12 (2026-04-23): 과금·승인 관련 필드는 CF 전용으로 분리
      //   허용 필드(화이트리스트): name, academy_type, owner_name, owner_phone, address
      //   차단 필드: plan, plan_expires_at, trial_ends_at, status, approved_at,
      //             reject_reason, owner_uid, academy_code, submitted_at, created_at
      allow update: if isAuthenticated()
                    && isNotDeleted()
                    && isAcademyMember(academyId)
                    && isAdmin()
                    && isAcademyActive(academyId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['name', 'academy_type', 'owner_name', 'owner_phone', 'address']);
      // 신규 학원 생성 — P1-5 (2026-04-23): 무제한 생성 방지
      //   · 온보딩 상태(users.academy_id 없음)에서만 허용 → uid당 학원 1개 제한
      //   · owner_uid 본인 확인 → 타인 소유 위조 차단
      //   · plan/status 값 강제 → 클라이언트가 'pro'나 'active'로 시작 불가
      allow create: if isAuthenticated()
                    && isOnboarding()
                    && request.resource.data.owner_uid == request.auth.uid
                    && request.resource.data.plan == 'trial'
                    && request.resource.data.status == 'pending';
      // 삭제는 불가 (탈퇴 처리는 Cloud Functions에서)
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // users/{uid} — 사용자
    // ─────────────────────────────────────────────
    match /users/{uid} {
      // 본인, 같은 학원 소속, 온보딩 중, 또는 학부모가 학생 문서 조회 시 읽기 가능
      // 온보딩 중 학부모: link_code로 자녀 계정 조회 필요
      // 이미 온보딩된 학부모: 추가 자녀 연동 시 link_code 조회 필요 — role=='student' 문서만 허용
      // 탈퇴 처리된 유저(deleted_at != null)는 본인 문서 외 접근 차단
      // (본인 문서는 읽어야 deleted_at 확인 후 signOut 처리 가능)
      allow read: if isAuthenticated()
                  && (request.auth.uid == uid
                      || (isNotDeleted()
                          && (isAcademyMember(resource.data.academy_id)
                              || isOnboarding()
                              || (getUserRole() == 'parent'
                                  && resource.data.get('role', '') == 'student'))));
      // 본인 문서만 수정 가능
      // - role: 미설정 상태에서만 한 번 허용 (온보딩), 이후 변경 불가
      // - is_active: 최초 역할 설정(온보딩) 시에만 true 허용, 이후 변경 불가 (Cloud Functions 전용)
      // - 불변/CF 전용 필드(블랙리스트): 본인 write 금지
      //   · deleted_at — 탈퇴 처리는 deleteUser CF 전용, 본인이 되돌릴 수 없음
      //   · teacher_feedback — staff가 학생에게 남기는 메모, 본인 자가조작 차단
      //   · created_by — 생성자 감사 기록, 불변
      //   · withdrawal_date — 학생 본인이 자기 퇴원일 임의 변경 차단 (staff 전용)
      allow update: if isAuthenticated()
                    && request.auth.uid == uid
                    && (
                      // 일반 수정: is_active 변경 불가
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['is_active'])
                      // 예외: 최초 역할 설정(온보딩) 시에만 is_active: true 허용
                      || ((!resource.data.keys().hasAny(['role']) || resource.data.get('role', '') == '')
                          && request.resource.data.get('is_active', false) == true)
                    )
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
                      || !resource.data.keys().hasAny(['role'])
                      || resource.data.get('role', '') == ''
                    )
                    // P1-4 (2026-05-25): 불변/CF 전용 필드 차단 목록 확장
                    //   - email, uid: 변조 시 학원 소속 위장 가능 → 완전 차단
                    //   - streak: onSubmissionCreated 트리거 전용 (자가조작 차단)
                    //   - withdrawal_date: staff 전용, 본인 수정 차단
                    && !request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['deleted_at', 'teacher_feedback', 'created_by', 'streak',
                                'withdrawal_date', 'email', 'uid'])
                    // phone_verified: false→true 전환만 허용 (OTP 인증 완료 기록용)
                    // 이미 true인 상태에서 변경 불가 — false로 되돌려 재인증 우회 차단
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone_verified'])
                        || (resource.data.get('phone_verified', false) == false
                            && request.resource.data.phone_verified == true))
                    // academy_id: 온보딩(빈 값) 상태에서만 최초 설정 허용
                    // 가입 완료 후 학원 이동은 Cloud Functions 전용 — 클라이언트 직접 변조 차단
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['academy_id'])
                        || resource.data.get('academy_id', '') == '');
      // admin/teacher: 같은 학원 학생의 반 이동(class_id), 비활성화(is_active),
      //               학생 피드백(teacher_feedback), 퇴원일(withdrawal_date) 처리 가능
      // 학생 기본 정보(name·birth_date·guardian_phone·enrollment_date)는 학원 운영자가
      //   직접 수정할 수 있도록 화이트리스트에 포함 — 법정 출석부 양식 유지에 필요
      // role·academy_id 등 핵심 필드는 변경 불가
      // withdrawal_date: 퇴원 처리/복구 시 클라이언트가 is_active와 함께 갱신 (법정 출석부 수강기간 종료일)
      allow update: if isAuthenticated()
                    && isStaff()
                    && resource.data.academy_id == getUserData().academy_id
                    && resource.data.role == 'student'
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly([
                         'class_id', 'is_active', 'teacher_feedback', 'withdrawal_date',
                         'name', 'birth_date', 'guardian_phone', 'enrollment_date',
                       ])
                    && isWithdrawalConsistent()
                    && isMyAcademyPendingOrActive();
      // admin: 선생님 담당반 지정/변경 (assigned_class_ids 필드만 허용)
      // 설정 화면에서 반별 담당 선생님 칩 토글 시 사용
      allow update: if isAuthenticated()
                    && isAdmin()
                    && resource.data.academy_id == getUserData().academy_id
                    && resource.data.role == 'teacher'
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['assigned_class_ids'])
                    && isMyAcademyPendingOrActive();
      // 학부모: 자녀 연동 시 guardian_phone 자동 기록 (법정 출석부용)
      // 자신의 children 배열에 포함된 학생의 guardian_phone 필드만 업데이트 허용
      allow update: if isAuthenticated()
                    && getUserRole() == 'parent'
                    && uid in getUserData().children
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['guardian_phone'])
                    && isAcademyPendingOrActive(resource.data.academy_id);
      // 신규 가입 시 본인 문서 생성 가능 — role/is_active 자가 부여 차단
      // role: 빈 값으로만 시작 가능 (이후 온보딩 update 분기에서 1회 한정 설정)
      // is_active: 최초 생성 시 false (또는 미지정) — 온보딩 완료 시점에 true 로 전환
      // deleted_at·teacher_feedback·created_by: 생성 시 포함 금지 (CF 전용/감사용)
      // role 을 'admin' 으로 자가 부여 후 syncUserRoleClaim 으로 권한 상승하는
      // Self-Elevation 경로를 Rules 레벨에서 차단
      allow create: if isAuthenticated()
                    && request.auth.uid == uid
                    && request.resource.data.get('role', '') == ''
                    && request.resource.data.get('is_active', false) == false
                    && !request.resource.data.keys().hasAny(['deleted_at', 'teacher_feedback', 'created_by']);
      // 삭제 불가 (소프트 삭제 사용: deleted_at 필드)
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // classes/{classId} — 반
    // ─────────────────────────────────────────────
    match /classes/{classId} {
      // 같은 학원 소속이거나, 온보딩 중인 사용자는 읽기 가능
      // 온보딩 중 학생이 invite_code로 반 조회 시 필요
      allow read: if isAuthenticated()
                  && (isAcademyMember(resource.data.academy_id) || isOnboarding());
      // admin 또는 teacher만 반 수정·삭제 가능
      // rejected 학원은 모든 쓰기 차단
      allow update, delete: if isAuthenticated()
                             && isAcademyMember(resource.data.academy_id)
                             && isStaff()
                             && isAcademyPendingOrActive(resource.data.academy_id);
      // 반 생성: rejected 학원 차단
      // pending 학원의 반 1개 제한은 Rules 에서 카운트 불가 →
      //   enforceClassLimitForPending 트리거(functions/academy/enforceClassLimit.ts)가
      //   onCreate 시점에 카운트 검증 후 위반 문서를 즉시 삭제 (서버 측 최후 방어선).
      // 클라이언트 UI 카운트 체크 + 트리거 enforcement 의 이중 방어 구조.
      allow create: if isAuthenticated()
                    && isStaff()
                    && isMyAcademyPendingOrActive();
    }

    // ─────────────────────────────────────────────
    // homeworks/{homeworkId} — 숙제
    // ─────────────────────────────────────────────
    match /homeworks/{homeworkId} {
      // 같은 반 소속이면 읽기 가능 — 탈퇴 유저 차단
      // 학부모: 해당 반이 자신과 같은 학원 소속이면 읽기 가능 (자녀 숙제 현황 확인용)
      allow read: if isAuthenticated()
                  && isNotDeleted()
                  && (getUserData().class_id == resource.data.class_id
                      || isStaff()
                      || (getUserRole() == 'parent'
                          && get(/databases/$(database)/documents/classes/$(resource.data.class_id)).data.academy_id
                             == getUserData().academy_id));
      // teacher 또는 admin만 숙제 출제 가능
      // rejected 학원은 쓰기 차단, 탈퇴 유저 차단
      allow update, delete: if isAuthenticated()
                             && isNotDeleted()
                             && isStaff()
                             && isMyAcademyPendingOrActive();
      allow create: if isAuthenticated()
                    && isNotDeleted()
                    && isStaff()
                    && isMyAcademyPendingOrActive();

      // homeworks/{homeworkId}/submissions/{studentUid} — 제출물
      // 필드 쓰기 권한 정책:
      //  - 학생 create: 전체 필드 (최초 제출)
      //  - 학생 update: image_urls, status, submitted_at, is_late 만 허용 (재제출)
      //                 feedback 계열은 변경 금지
      //  - is_late는 학생이 임의 값 저장 가능하나 Cloud Function(verifySubmissionLate)이
      //    서버 시간 기준으로 즉시 교정 → 조작해도 스트릭 초기화까지 자동 처리됨
      //  - teacher/admin update: feedback, feedback_comment, status 만 허용
      //  - 삭제 금지
      match /submissions/{studentUid} {
        // 본인(학생), teacher, admin, 자녀의 학부모 읽기 가능
        allow read: if isAuthenticated()
                    && (request.auth.uid == studentUid
                        || isStaff()
                        || (getUserRole() == 'parent'
                            && studentUid in getUserData().children));
        // 학생 본인 최초 제출 (rejected 학원은 제출 차단)
        // 멱등성 마커(streak_processed, feedback_notified_for)는 서버 전용 — create 시 포함 금지
        // (학생이 미리 끼워 넣으면 Cloud Function 트리거가 skip되어 스트릭/알림이 누락됨)
        allow create: if isAuthenticated()
                      && request.auth.uid == studentUid
                      && getUserRole() == 'student'
                      && !('streak_processed' in request.resource.data)
                      && !('feedback_notified_for' in request.resource.data)
                      && isMyAcademyPendingOrActive();
        // 학생 본인 재제출 — 제출 관련 필드만 변경 허용
        // feedback 은 다시풀기 후 재제출 시 null 로 리셋만 허용 (임의 값 변경 차단)
        // is_retry 는 다시풀기 후 재제출 시 true 로 set — 학생 화면에서 "다시푸는중" 표시
        allow update: if isAuthenticated()
                      && request.auth.uid == studentUid
                      && getUserRole() == 'student'
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['image_urls', 'status', 'submitted_at', 'is_late', 'feedback', 'is_retry'])
                      && request.resource.data.feedback == null
                      && isMyAcademyPendingOrActive();
        // teacher·admin 피드백 업데이트 — feedback 계열 필드만 허용
        allow update: if isAuthenticated()
                      && isStaff()
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['feedback', 'feedback_comment', 'status'])
                      && isMyAcademyPendingOrActive();
        // 삭제 불가
        allow delete: if false;
      }
    }

    // ─────────────────────────────────────────────
    // attendances/{classId_date} — 출결
    // (문서 ID 형식: {classId}_{YYYY-MM-DD})
    // ─────────────────────────────────────────────
    match /attendances/{attendanceDoc} {
      // 같은 학원 소속 멤버만 읽기 가능 (타 학원 출결 열람 차단)
      allow read: if isAuthenticated() && isAcademyMember(resource.data.academy_id);
      // teacher, admin만 출결 입력·수정 가능
      // rejected 학원은 쓰기 차단
      allow write: if isAuthenticated()
                   && isStaff()
                   && isMyAcademyPendingOrActive();
      allow create: if isAuthenticated()
                    && isStaff()
                    && isMyAcademyPendingOrActive();

      // 학부모: 자녀의 결석 사유 사전 등록 시 부모 문서 academy_id 필드만 merge 허용
      // (records 서브컬렉션 쓰기는 별도 규칙 — admin 통계 쿼리용 academy_id 누락 방지)
      // - 본인 학원의 academy_id로만 설정 가능 (타 학원 변조 차단)
      // - 다른 필드 변경·삭제 불가
      allow create: if isAuthenticated()
                    && getUserRole() == 'parent'
                    && request.resource.data.keys().hasOnly(['academy_id'])
                    && request.resource.data.academy_id == getUserData().academy_id
                    && isMyAcademyPendingOrActive();
      allow update: if isAuthenticated()
                    && getUserRole() == 'parent'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['academy_id'])
                    && request.resource.data.academy_id == getUserData().academy_id
                    && isMyAcademyPendingOrActive();

      // ── records 서브컬렉션 ──────────────────────
      // attendances/{classId_date}/records/{studentUid}
      // 부모 규칙은 서브컬렉션에 자동 적용되지 않으므로 별도 선언 필수
      match /records/{studentUid} {
        // teacher·admin: 읽기 가능 (명렬표 실시간 구독)
        // student: 본인 기록만 읽기 가능 (월간 캘린더용)
        // parent: 본인 자녀(children 배열)의 기록만 읽기 가능
        allow read: if isAuthenticated()
                    && (isStaff()
                        || request.auth.uid == studentUid
                        || (getUserRole() == 'parent'
                            && studentUid in getUserData().children))
                    && isMyAcademyPendingOrActive();

        // teacher·admin: 출결 상태(status) 쓰기 가능
        allow write, create: if isAuthenticated()
                             && isStaff()
                             && isMyAcademyPendingOrActive();

        // 학부모: 본인 자녀의 결석/지각을 사전 등록(create) 가능
        // status는 absent 또는 late만 허용 (present 입력 불가)
        // reason_source 는 'parent' 만 허용 — 다른 값으로 위장 차단
        // 멱등성 마커(reason_notified_for)는 서버 전용 — create 시 포함 금지
        // P2-C(2026-05-20): 자녀 학원 일치 검증 — 학원 이동 후 children 잔존 시
        //   타 학원 records 생성 경로 차단
        allow create: if isAuthenticated()
                      && getUserRole() == 'parent'
                      && studentUid in getUserData().children
                      && get(/databases/$(database)/documents/users/$(studentUid)).data.academy_id
                         == getUserData().academy_id
                      && request.resource.data.status in ['absent', 'late']
                      && (!('reason_source' in request.resource.data)
                          || request.resource.data.reason_source == 'parent')
                      && !('reason_notified_for' in request.resource.data)
                      && isMyAcademyPendingOrActive();

        // 학부모: 본인 자녀의 reason·status·reason_source 업데이트 가능
        // status는 absent 또는 late로만 변경 허용
        // reason_source 는 'parent' 만 허용
        // P2-C(2026-05-20): 자녀 학원 일치 검증 — create 와 동일 원칙
        allow update: if isAuthenticated()
                      && getUserRole() == 'parent'
                      && studentUid in getUserData().children
                      && get(/databases/$(database)/documents/users/$(studentUid)).data.academy_id
                         == getUserData().academy_id
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reason', 'status', 'reason_source'])
                      && request.resource.data.status in ['absent', 'late']
                      && (!('reason_source' in request.resource.data)
                          || request.resource.data.reason_source == 'parent')
                      && isMyAcademyPendingOrActive();
      }
    }

    // ─────────────────────────────────────────────
    // notices/{noticeId} — 공지사항
    // ─────────────────────────────────────────────
    match /notices/{noticeId} {
      // 같은 학원 소속이면 읽기 가능 — 탈퇴 유저 차단
      allow read: if isAuthenticated()
                  && isNotDeleted()
                  && isAcademyMember(resource.data.academy_id);
      // teacher, admin만 공지 내용 수정·삭제 가능
      // rejected 학원은 쓰기 차단, 탈퇴 유저 차단
      allow update, delete: if isAuthenticated()
                             && isNotDeleted()
                             && isAcademyMember(resource.data.academy_id)
                             && isStaff()
                             && isAcademyPendingOrActive(resource.data.academy_id);
      // 학생·학부모: read_by 필드만 업데이트 가능 (공지 읽음 처리 전용) — 탈퇴 유저 차단
      allow update: if isAuthenticated()
                    && isNotDeleted()
                    && isAcademyMember(resource.data.academy_id)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read_by']);
      allow create: if isAuthenticated()
                    && isNotDeleted()
                    && isStaff()
                    && isMyAcademyPendingOrActive();
    }

    // ─────────────────────────────────────────────
    // notifications/{notifId} — 알림
    // ─────────────────────────────────────────────
    // P2-B (2026-05-20): get/list 권한 명시 분리 + list 페이지 사이즈 제한
    //   - get: 본인 target_uid 매치
    //   - list: 본인 target_uid 매치 강제 (Firestore가 쿼리 필터로 강제 검증)
    //           + limit ≤ 100 으로 대량 enumeration 비용 공격 방어
    //   - 인박스 화면(notification-inbox.tsx) 은 limit(50) 으로 안전 통과
    match /notifications/{notifId} {
      // 수신자 본인만 단건 조회 가능
      allow get: if isAuthenticated()
                 && request.auth.uid == resource.data.target_uid;
      // 수신자 본인만 리스트 조회 가능
      // - resource.data.target_uid 매치 → 클라이언트 쿼리에 where('target_uid','==',auth.uid) 강제
      //   (Firestore "rules are not filters": query 필터가 매치되지 않으면 통째로 거부)
      // - request.query.limit ≤ 100 → 대량 enumeration 비용 공격 방어
      allow list: if isAuthenticated()
                  && request.auth.uid == resource.data.target_uid
                  && request.query.limit <= 100;
      // 생성은 Cloud Functions에서만 (클라이언트 직접 생성 금지)
      allow create: if false;
      // 수신자 본인이 is_read 필드만 업데이트 가능 (읽음 처리 전용)
      // 다른 필드(target_uid, type, body 등)는 변경 불가
      allow update: if isAuthenticated()
                    && request.auth.uid == resource.data.target_uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read']);
      // 삭제 불가
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // videos/{videoId} — 수업 영상 (스탠다드/프로 전용 쓰기)
    // ─────────────────────────────────────────────
    // 정책 (PRD 685 줄 플랜표 기준):
    // - 읽기: 기존 기능 유지 (이미 등록된 영상은 플랜 전환 후에도 학생이 볼 수 있음)
    // - 쓰기(등록·수정·삭제): standard/pro 플랜만 허용 (trial·starter·free 차단)
    //   → 체험판/무료 학원이 DevTools 등으로 Rules 우회해 영상 등록하는 시나리오 차단
    match /videos/{videoId} {
      // teacher·admin: 자기 학원 소속이면 읽기 가능 (담당 반 무관하게 접근)
      // student: 본인 반 영상만 읽기 가능
      allow read: if isAuthenticated()
                  && isMyAcademyPendingOrActive()
                  && (isStaff()
                      || getUserData().class_id == resource.data.class_id);
      // teacher 또는 admin만 영상 등록 가능, rejected 학원은 차단, 스탠다드/프로 필수
      allow create: if isAuthenticated()
                    && isStaff()
                    && isMyAcademyPendingOrActive()
                    && isMyAcademyStandardOrPro();
      // 같은 학원 소속 teacher·admin만 수정·삭제 가능, 스탠다드/프로 필수
      allow update, delete: if isAuthenticated()
                            && isStaff()
                            && isAcademyMember(resource.data.academy_id)
                            && isAcademyPendingOrActive(resource.data.academy_id)
                            && isStandardOrProPlan(resource.data.academy_id);
    }

    // ─────────────────────────────────────────────
    // app_config/{docId} — 앱 설정 (버전 정보 등, 읽기 전용)
    // lib/versionCheck.ts에서 app_config/version 문서를 조회
    // ─────────────────────────────────────────────
    match /app_config/{docId} {
      // 로그인 여부와 무관하게 읽기 허용 — 버전 체크는 앱 진입 초기에 수행
      allow read: if true;
      allow write: if false; // 콘솔/Functions에서만 관리
    }

    // 구버전 호환용 (이전에 잘못 생성된 컬렉션명 대응)
    match /appConfig/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ─────────────────────────────────────────────
    // phone_lookups/{phone} — 휴대폰 번호 → uid 매핑 (중복 가입 방지용)
    // ─────────────────────────────────────────────
    // 문서 ID: E.164 형식 휴대폰 번호 (예: +821012345678)
    // 본문: { uid: string, created_at: Timestamp }
    //
    // 정책:
    // - 로그인 사용자는 본인 phone_lookups 문서를 직접 get 으로 조회 가능 (존재 여부만 확인)
    // - users 컬렉션 list 권한 없이도 중복 체크 가능 — list 권한 노출 위험 차단
    // - 쓰기는 본인 uid 가 일치하는 경우에만 (기존 매핑 덮어쓰기 차단)
    match /phone_lookups/{phone} {
      // 존재 여부만 확인하므로 인증된 사용자라면 누구나 get 허용
      // (전화번호로 다른 유저 정보 역추적은 불가 — 이 문서는 uid만 가짐)
      allow get: if isAuthenticated();
      // list 는 차단 — phone 전체 enumeration 방지
      allow list: if false;
      // 본인 uid 기록만 허용 — 타인 매핑 위조 차단
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid;
      // 기존 매핑은 변경/삭제 불가 — Cloud Functions 에서만 정리
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────
    // rateLimits/{key} — 온보딩 코드 재시도 제한
    // validateOnboardingCode Cloud Function에서만 읽기·쓰기 (Admin SDK)
    // 클라이언트 직접 접근 금지 — 카운터 조작·초기화 공격 차단
    // ─────────────────────────────────────────────
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────
    // payments/{paymentId} — 결제 내역
    // verifyTossPayment Cloud Function에서만 생성, admin만 조회
    // ─────────────────────────────────────────────
    match /payments/{paymentId} {
      // 같은 학원 admin만 본인 학원 결제 내역 조회 가능
      allow read: if isAuthenticated()
                  && isAdmin()
                  && isAcademyMember(resource.data.academy_id);
      // 쓰기는 Cloud Function(Admin SDK)에서만 처리
      allow write: if false;
    }
  }
}

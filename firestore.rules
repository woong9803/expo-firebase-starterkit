rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // 공통 헬퍼 함수
    // ─────────────────────────────────────────────

    // 로그인 여부 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 현재 사용자 문서 가져오기
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 현재 사용자의 역할 반환
    function getUserRole() {
      return getUserData().role;
    }

    // 특정 학원의 소속 멤버인지 확인
    function isAcademyMember(academyId) {
      return getUserData().academy_id == academyId;
    }

    // 온보딩 중인 사용자 — 아직 학원에 속하지 않은 상태
    // users 문서가 없거나 academy_id가 빈 값이면 true
    // get('academy_id', '') 로 필드 없음/null 모두 안전하게 처리
    function isOnboarding() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('academy_id', '') == '';
    }

    // admin 또는 teacher 역할인지 확인
    function isStaff() {
      return getUserRole() in ['admin', 'teacher'];
    }

    // admin 역할인지 확인
    function isAdmin() {
      return getUserRole() == 'admin';
    }

    // 학원 승인 상태가 active인지 확인
    // 선생님 초대 등 active 상태에서만 허용되는 기능에 사용
    function isAcademyActive(academyId) {
      return get(/databases/$(database)/documents/academies/$(academyId)).data.status == 'active';
    }

    // 학원 승인 상태가 pending 또는 active인지 확인 (rejected 차단용)
    // 승인 대기 중에도 기본 기능(출결·숙제·공지)은 허용
    function isAcademyPendingOrActive(academyId) {
      return get(/databases/$(database)/documents/academies/$(academyId)).data.status
             in ['pending', 'active'];
    }

    // 현재 사용자의 academy_id로 학원 상태 확인
    function isMyAcademyPendingOrActive() {
      return isAcademyPendingOrActive(getUserData().academy_id);
    }

    // ─────────────────────────────────────────────
    // academies/{academyId} — 학원
    // ─────────────────────────────────────────────
    match /academies/{academyId} {
      // 소속 멤버이거나, 온보딩 중인 사용자는 읽기 가능
      // 온보딩 중 선생님이 academy_code로 학원 조회 시 필요
      allow read: if isAuthenticated()
                  && (isAcademyMember(academyId) || isOnboarding());
      // admin만 학원 정보 수정 가능 (active 상태에서만)
      allow update: if isAuthenticated()
                    && isAcademyMember(academyId)
                    && isAdmin()
                    && isAcademyActive(academyId);
      // 신규 학원 생성은 누구든 가능 (가입 온보딩 흐름 — pending 상태로 생성)
      allow create: if isAuthenticated();
      // 삭제는 불가 (탈퇴 처리는 Cloud Functions에서)
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // users/{uid} — 사용자
    // ─────────────────────────────────────────────
    match /users/{uid} {
      // 본인, 같은 학원 소속, 온보딩 중, 또는 학부모가 학생 문서 조회 시 읽기 가능
      // 온보딩 중 학부모: link_code로 자녀 계정 조회 필요
      // 이미 온보딩된 학부모: 추가 자녀 연동 시 link_code 조회 필요 — role=='student' 문서만 허용
      allow read: if isAuthenticated()
                  && (request.auth.uid == uid
                      || isAcademyMember(resource.data.academy_id)
                      || isOnboarding()
                      || (getUserRole() == 'parent'
                          && resource.data.get('role', '') == 'student'));
      // 본인 문서만 수정 가능
      // - role: 미설정 상태에서만 한 번 허용 (온보딩), 이후 변경 불가
      // - is_active: 클라이언트 직접 변경 불가 (Cloud Functions 전용)
      allow update: if isAuthenticated()
                    && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['is_active'])
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
                      || !resource.data.keys().hasAny(['role'])
                      || resource.data.get('role', '') == ''
                    );
      // admin/teacher: 같은 학원 학생의 반 이동(class_id), 비활성화(is_active) 처리 가능
      // role·academy_id 등 핵심 필드는 변경 불가 — class_id·is_active만 허용
      allow update: if isAuthenticated()
                    && isStaff()
                    && resource.data.academy_id == getUserData().academy_id
                    && resource.data.role == 'student'
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['class_id', 'is_active'])
                    && isMyAcademyPendingOrActive();
      // 학부모: 자녀 연동 시 guardian_phone 자동 기록 (법정 출석부용)
      // 자신의 children 배열에 포함된 학생의 guardian_phone 필드만 업데이트 허용
      allow update: if isAuthenticated()
                    && getUserRole() == 'parent'
                    && uid in getUserData().children
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['guardian_phone'])
                    && isAcademyPendingOrActive(resource.data.academy_id);
      // 신규 가입 시 본인 문서 생성 가능
      allow create: if isAuthenticated() && request.auth.uid == uid;
      // 삭제 불가 (소프트 삭제 사용: deleted_at 필드)
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // classes/{classId} — 반
    // ─────────────────────────────────────────────
    match /classes/{classId} {
      // 같은 학원 소속이거나, 온보딩 중인 사용자는 읽기 가능
      // 온보딩 중 학생이 invite_code로 반 조회 시 필요
      allow read: if isAuthenticated()
                  && (isAcademyMember(resource.data.academy_id) || isOnboarding());
      // admin 또는 teacher만 반 수정·삭제 가능
      // rejected 학원은 모든 쓰기 차단
      allow update, delete: if isAuthenticated()
                             && isAcademyMember(resource.data.academy_id)
                             && isStaff()
                             && isAcademyPendingOrActive(resource.data.academy_id);
      // 반 생성: pending 상태에서는 최대 1개 제한 (카운트는 앱/CF에서 추가 검증)
      // rejected 학원은 반 생성 불가
      allow create: if isAuthenticated()
                    && isStaff()
                    && isMyAcademyPendingOrActive();
    }

    // ─────────────────────────────────────────────
    // homeworks/{homeworkId} — 숙제
    // ─────────────────────────────────────────────
    match /homeworks/{homeworkId} {
      // 같은 반 소속이면 읽기 가능
      // 학부모: 해당 반이 자신과 같은 학원 소속이면 읽기 가능 (자녀 숙제 현황 확인용)
      allow read: if isAuthenticated()
                  && (getUserData().class_id == resource.data.class_id
                      || isStaff()
                      || (getUserRole() == 'parent'
                          && get(/databases/$(database)/documents/classes/$(resource.data.class_id)).data.academy_id
                             == getUserData().academy_id));
      // teacher 또는 admin만 숙제 출제 가능
      // rejected 학원은 쓰기 차단
      allow update, delete: if isAuthenticated()
                             && isStaff()
                             && isMyAcademyPendingOrActive();
      allow create: if isAuthenticated()
                    && isStaff()
                    && isMyAcademyPendingOrActive();

      // homeworks/{homeworkId}/submissions/{studentUid} — 제출물
      match /submissions/{studentUid} {
        // 본인(학생), teacher, admin, 자녀의 학부모 읽기 가능
        allow read: if isAuthenticated()
                    && (request.auth.uid == studentUid
                        || isStaff()
                        || (getUserRole() == 'parent'
                            && studentUid in getUserData().children));
        // 학생 본인만 제출(create/write) 가능 (rejected 학원은 제출 차단)
        allow write: if isAuthenticated()
                     && request.auth.uid == studentUid
                     && getUserRole() == 'student'
                     && isMyAcademyPendingOrActive();
        allow create: if isAuthenticated()
                      && request.auth.uid == studentUid
                      && getUserRole() == 'student'
                      && isMyAcademyPendingOrActive();
        // teacher, admin은 피드백(feedback, status 필드) 업데이트만 가능
        allow update: if isAuthenticated()
                      && isStaff()
                      && isMyAcademyPendingOrActive();
      }
    }

    // ─────────────────────────────────────────────
    // attendances/{classId_date} — 출결
    // (문서 ID 형식: {classId}_{YYYY-MM-DD})
    // ─────────────────────────────────────────────
    match /attendances/{attendanceDoc} {
      // 같은 학원 소속 멤버만 읽기 가능 (타 학원 출결 열람 차단)
      allow read: if isAuthenticated() && isAcademyMember(resource.data.academy_id);
      // teacher, admin만 출결 입력·수정 가능
      // rejected 학원은 쓰기 차단
      allow write: if isAuthenticated()
                   && isStaff()
                   && isMyAcademyPendingOrActive();
      allow create: if isAuthenticated()
                    && isStaff()
                    && isMyAcademyPendingOrActive();

      // ── records 서브컬렉션 ──────────────────────
      // attendances/{classId_date}/records/{studentUid}
      // 부모 규칙은 서브컬렉션에 자동 적용되지 않으므로 별도 선언 필수
      match /records/{studentUid} {
        // teacher·admin: 읽기 가능 (명렬표 실시간 구독)
        // student: 본인 기록만 읽기 가능 (월간 캘린더용)
        // parent: 본인 자녀(children 배열)의 기록만 읽기 가능
        allow read: if isAuthenticated()
                    && (isStaff()
                        || request.auth.uid == studentUid
                        || (getUserRole() == 'parent'
                            && studentUid in getUserData().children))
                    && isMyAcademyPendingOrActive();

        // teacher·admin: 출결 상태(status) 쓰기 가능
        allow write, create: if isAuthenticated()
                             && isStaff()
                             && isMyAcademyPendingOrActive();

        // 학부모: 본인 자녀의 결석/지각을 사전 등록(create) 가능
        // status는 absent 또는 late만 허용 (present·onLeave 입력 불가)
        allow create: if isAuthenticated()
                      && getUserRole() == 'parent'
                      && studentUid in getUserData().children
                      && request.resource.data.status in ['absent', 'late']
                      && isMyAcademyPendingOrActive();

        // 학부모: 본인 자녀의 reason·status 업데이트 가능
        // status는 absent 또는 late로만 변경 허용
        allow update: if isAuthenticated()
                      && getUserRole() == 'parent'
                      && studentUid in getUserData().children
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reason', 'status'])
                      && request.resource.data.status in ['absent', 'late']
                      && isMyAcademyPendingOrActive();
      }
    }

    // ─────────────────────────────────────────────
    // notices/{noticeId} — 공지사항
    // ─────────────────────────────────────────────
    match /notices/{noticeId} {
      // 같은 학원 소속이면 읽기 가능
      allow read: if isAuthenticated()
                  && isAcademyMember(resource.data.academy_id);
      // teacher, admin만 공지 내용 수정·삭제 가능
      // rejected 학원은 쓰기 차단
      allow update, delete: if isAuthenticated()
                             && isAcademyMember(resource.data.academy_id)
                             && isStaff()
                             && isAcademyPendingOrActive(resource.data.academy_id);
      // 학생·학부모: read_by 필드만 업데이트 가능 (공지 읽음 처리 전용)
      // 다른 필드는 수정 불가 — hasOnly(['read_by'])로 제한
      allow update: if isAuthenticated()
                    && isAcademyMember(resource.data.academy_id)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read_by']);
      allow create: if isAuthenticated()
                    && isStaff()
                    && isMyAcademyPendingOrActive();
    }

    // ─────────────────────────────────────────────
    // notifications/{notifId} — 알림
    // ─────────────────────────────────────────────
    match /notifications/{notifId} {
      // 수신자 본인만 읽기 가능
      allow read: if isAuthenticated()
                  && request.auth.uid == resource.data.target_uid;
      // 클라이언트 직접 쓰기 금지 — Cloud Functions에서만 생성
      allow write: if false;
    }

    // ─────────────────────────────────────────────
    // appConfig/v1 — 앱 버전 설정 (읽기 전용)
    // ─────────────────────────────────────────────
    match /appConfig/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // 콘솔/Functions에서만 관리
    }
  }
}

# Firebase 설정
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google 로그인 — Firebase 콘솔 → Authentication → Sign-in method → Google → 웹 클라이언트 ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# 카카오 로그인 — developers.kakao.com → 앱 → 앱 키 → 네이티브 앱 키
EXPO_PUBLIC_KAKAO_APP_KEY=

# 카카오 Admin Key (Cloud Functions 전용 — 절대 클라이언트에 포함 금지)
KAKAO_ADMIN_KEY=

# 카카오 앱 ID (Cloud Functions 전용 — 토큰 앱 ID 교차 검증용, 숫자)
KAKAO_APP_ID=

# 웹 관리자 대시보드 URL — Pro 플랜 결제는 웹에서 진행 (토스 SDK 보안)
# 예: https://eduonepass.app 또는 https://<project>.web.app
EXPO_PUBLIC_WEB_DASHBOARD_URL=

# 토스페이먼츠 시크릿 키 (Cloud Functions 전용 — 결제 검증용)
TOSS_SECRET_KEY=

# MCP 설정
GITHUB_PERSONAL_ACCESS_TOKEN=     # GitHub Settings → Developer settings → Personal access tokens
FIGMA_API_KEY=                    # Figma → Help and account → Account settings → Personal access tokens

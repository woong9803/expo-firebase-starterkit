# Firebase 설정
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google 로그인 — Firebase 콘솔 → Authentication → Sign-in method → Google → 웹 클라이언트 ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# 카카오 로그인 — developers.kakao.com → 앱 → 앱 키 → 네이티브 앱 키
EXPO_PUBLIC_KAKAO_APP_KEY=

# 카카오 Admin Key (Cloud Functions 전용 — 절대 클라이언트에 포함 금지)
KAKAO_ADMIN_KEY=

# MCP 설정
GITHUB_PERSONAL_ACCESS_TOKEN=     # GitHub Settings → Developer settings → Personal access tokens
FIGMA_API_KEY=                    # Figma → Help and account → Account settings → Personal access tokens
